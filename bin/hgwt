#!/usr/bin/env bash
# hgwt — herdr plugin: Mercurial "worktrees" via `hg share`, with git fallthrough.
#
# CLI (hg only; mirrors `herdr worktree`):
#   hgwt list   [--json]
#   hgwt create --bookmark NAME [--base REV] [--path DIR] [--label TEXT] [--no-focus]
#   hgwt open   (--bookmark NAME | --path DIR) [--label TEXT] [--no-focus]
#   hgwt remove [--bookmark NAME | --path DIR] [--force] [--strip]
#   hgwt prune  [--dry-run]             remove closed shares + bookmarks whose work landed
#   hgwt close-group [--prune]          close the repo's workspace and all its shares
#   hgwt info   [--fetch]               full details: bookmark, parent, remote, drafts…
#   (all take --cwd DIR or --workspace ID to pick the repo; default: current dir)
#   hgwt setup  [--yes|--uninstall|--status|--dismiss]
#
# Plugin internals:
#   hgwt action new|open|remove|prune|close-group|info|setup   open the matching popup
#   hgwt ui     new|open|remove|prune|close-group|info|setup   interactive popup body
#   hgwt refresh [--all|--event|--workspace ID|--cwd DIR|--pane ID DIR] [auto|force|cache]
#   hgwt startup
#
# Kept bash 3.2 compatible (macOS /bin/bash).
set -euo pipefail

PLUGIN_ID="${HERDR_PLUGIN_ID:-mpzarde.hg-worktree}"
SOURCE="plugin:hg-worktree"
export HGPLAIN=1

: "${HERDR_PLUGIN_CONFIG_DIR:=${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/config/$PLUGIN_ID}"
# shellcheck disable=SC1091
[ -f "$HERDR_PLUGIN_CONFIG_DIR/config.env" ] && . "$HERDR_PLUGIN_CONFIG_DIR/config.env"
WT_ROOT="${HG_WORKTREES_DIR:-$HOME/.herdr/worktrees}"; WT_ROOT="${WT_ROOT/#\~/$HOME}"
LAYOUT="${HG_WORKTREES_LAYOUT:-central}"            # central | sibling
SHARE_BOOKMARKS="${HG_SHARE_BOOKMARKS:-1}"
NEW_KIND="${HG_NEW_BRANCH:-bookmark}"               # bookmark | branch (named branch)
COPY_GLOBS="${HGWT_COPY:-}"                         # untracked files to copy into new shares
BM_MAX="${HG_BOOKMARK_MAX:-auto}"                   # sidebar bookmark length: auto | 0 (off) | N
BM_STRIP="${HG_BOOKMARK_STRIP:-}"                   # regex removed from names in the sidebar
REMOTE_MINUTES="${HG_REMOTE_CHECK_MINUTES:-10}"     # 0 disables incoming checks
REMOTE_TIMEOUT="${HG_REMOTE_TIMEOUT:-20}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-hg"

exec 3<&0  # keep the popup terminal for pick(), whose stdin is a pipe
herdr() { "${HERDR_BIN_PATH:-herdr}" "$@"; }
die() { printf 'hgwt: %s\n' "$*" >&2; exit 1; }
warn() { printf 'hgwt: %s\n' "$*" >&2; }
ctx() { [ -n "${HERDR_PLUGIN_CONTEXT_JSON:-}" ] && jq -r "$1 // empty" <<<"$HERDR_PLUGIN_CONTEXT_JSON" || true; }
with_timeout() { local s="$1"; shift; perl -e 'alarm shift; exec @ARGV or exit 127' "$s" "$@"; }

# Raw socket request for methods the CLI doesn't expose (workspace.move).
sock() {
  printf '{"id":"hgwt:%s","method":"%s","params":%s}\n' "$1" "$1" "$2" |
    nc -U -w 2 "$HERDR_SOCKET_PATH" 2>/dev/null | head -n 1
}

# --- repo helpers ------------------------------------------------------------

current_cwd() {
  local d
  d="$(ctx .focused_pane_cwd)"; [ -n "$d" ] || d="$(ctx .workspace_cwd)"
  [ -n "$d" ] || d="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
  printf '%s\n' "$d"
}
current_ws() {
  local w; w="$(ctx .workspace_id)"
  printf '%s\n' "${w:-${HERDR_WORKSPACE_ID:-${HERDR_ACTIVE_WORKSPACE_ID:-}}}"
}

# hg | git | none  (deepest repo root wins if both)
vcs_of() {
  local hr gr
  hr="$(cd "$1" 2>/dev/null && hg root 2>/dev/null || true)"
  gr="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$hr" ] && [ ${#hr} -ge ${#gr} ]; then echo hg
  elif [ -n "$gr" ]; then echo git
  else echo none; fi
}

hg_root() { (cd "$1" && hg root) | { read -r r; (cd "$r" && pwd -P); }; }
wc_label() { # active bookmark, else the working copy's branch (includes a pending `hg branch`)
  local b; b="$(hg -R "$1" log -r . -T '{activebookmark}' 2>/dev/null)" || { echo '?'; return; }
  [ -n "$b" ] || b="$(hg -R "$1" branch 2>/dev/null || echo '?')"
  printf '%s\n' "$b"
}
branch_exists() { hg -R "$1" log -r "branch('literal:$2')" -T x 2>/dev/null | grep -q .; }

# Source repo of a checkout dir (itself when it isn't a share).
source_of_root() {
  local r="$1" sp
  if [ -f "$r/.hg/sharedpath" ]; then
    sp="$(cat "$r/.hg/sharedpath")"
    case "$sp" in /*) ;; *) sp="$r/.hg/$sp" ;; esac
    (cd "$sp/.." 2>/dev/null && pwd -P) || true
  else
    printf '%s\n' "$r"
  fi
}
hg_source_root() { source_of_root "$(hg_root "$1")"; }

slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/--*/-/g; s/^-//; s/-$//'; }

share_dest() { # src bookmark
  if [ "$LAYOUT" = sibling ]; then printf '%s/%s-%s\n' "$(dirname "$1")" "$(basename "$1")" "$(slug "$2")"
  else printf '%s/%s/%s\n' "$WT_ROOT" "$(basename "$1")" "$(slug "$2")"; fi
}

is_share_of() { # dir src
  [ "$1" != "$2" ] && [ -f "$1/.hg/sharedpath" ] && [ "$(source_of_root "$1")" = "$2" ]
}

# Shares created with --path live outside both layouts; they're listed here.
extra_file() { printf '%s/.hg/herdr-hg-shares\n' "$1"; }
unrecord_share() { # src path
  local f; f="$(extra_file "$1")"; [ -f "$f" ] || return 0
  grep -vxF -- "$2" "$f" >"$f.tmp" || true
  if [ -s "$f.tmp" ]; then mv "$f.tmp" "$f"; else rm -f "$f.tmp" "$f"; fi
}

# "<path>\t<bookmark-or-branch>" for every share of $1: both layouts plus --path ones.
hg_shares() {
  local src="$1" repo d seen=$'\n'
  repo="$(basename "$src")"
  while IFS= read -r d; do
    [ -d "$d" ] || continue
    d="$(cd "$d" && pwd -P)"
    case "$seen" in *$'\n'"$d"$'\n'*) continue ;; esac
    seen="$seen$d"$'\n'
    is_share_of "$d" "$src" || continue
    printf '%s\t%s\n' "$d" "$(wc_label "$d")"
  done < <(for d in "$WT_ROOT/$repo"/*/ "$(dirname "$src")/$repo"-*/; do printf '%s\n' "$d"; done
           cat "$(extra_file "$src")" 2>/dev/null || true)
}

find_share() { # src bookmark -> path (exact bookmark/branch match, then slug path)
  local p b
  while IFS=$'\t' read -r p b; do [ "$b" = "$2" ] && { echo "$p"; return 0; }; done < <(hg_shares "$1")
  p="$(share_dest "$1" "$2")"; [ -d "$p" ] && is_share_of "$(cd "$p" && pwd -P)" "$1" && { (cd "$p" && pwd -P); return 0; }
  return 1
}

# --- workspace helpers -------------------------------------------------------

# "ws\tcwd" per workspace (focused pane's cwd, else first pane), in sidebar order.
ws_map() {
  local panes
  panes="$(herdr pane list 2>/dev/null || echo '{}')"
  herdr workspace list 2>/dev/null | jq -r --argjson p "$panes" '
    .result.workspaces[]?.workspace_id as $w
    | ([$p.result.panes[]? | select(.workspace_id == $w)] | (map(select(.focused)) + .) | .[0].cwd // "") as $c
    | "\($w)\t\($c)"'
}
ws_cwd() { ws_map | awk -F'\t' -v w="$1" '$1 == w { print $2; exit }'; }
ws_label() { herdr workspace get "$1" 2>/dev/null | jq -r '.result.workspace.label // empty'; }

ws_for_path() { # first workspace whose cwd is $1 or inside it
  ws_map | awk -F'\t' -v p="$1" '$2 == p || index($2, p "/") == 1 { print $1; exit }'
}

# Source repo for a workspace's cwd, or empty when not hg.
ws_source() { local c="$1"; [ -n "$c" ] && [ "$(vcs_of "$c")" = hg ] && hg_source_root "$c" || true; }

# Workspaces belonging to source repo $1: "ws\trole\tpath" (role = source|share)
group_members() {
  local src="$1" ws c r
  while IFS=$'\t' read -r ws c; do
    [ -n "$c" ] && [ "$(vcs_of "$c")" = hg ] || continue
    r="$(hg_root "$c")"
    if [ "$r" = "$src" ]; then printf '%s\tsource\t%s\n' "$ws" "$r"
    elif is_share_of "$r" "$src"; then printf '%s\tshare\t%s\n' "$ws" "$r"; fi
  done < <(ws_map)
}

# Keep workspace $1 inside the block that starts at its source's workspace:
# source, then its shares. No-op if already there or the source isn't open.
regroup() {
  local ws="$1" src="$2" ids members parent idx i id in_block=0
  members="$(group_members "$src")"
  parent="$(awk -F'\t' '$2 == "source" { print $1; exit }' <<<"$members")"
  [ -n "$parent" ] && [ "$parent" != "$ws" ] || return 0
  ids="$(herdr workspace list | jq -r '.result.workspaces[].workspace_id')"
  idx=-1; i=0
  for id in $ids; do
    if [ "$id" = "$parent" ]; then idx=$i; in_block=1
    elif [ $in_block = 1 ]; then
      if awk -F'\t' -v w="$id" '$1 == w && $2 == "share" { f = 1 } END { exit !f }' <<<"$members"; then
        [ "$id" = "$ws" ] && return 0          # already grouped
        idx=$i
      else in_block=0; fi
    fi
    i=$((i + 1))
  done
  [ $idx -ge 0 ] || return 0
  # insert_index means "before the workspace currently at this index"
  sock workspace.move "{\"workspace_id\":\"$ws\",\"insert_index\":$((idx + 1))}" >/dev/null || true
}

# Sidebar label: "↳ bookmark" under an open source workspace, else "repo ▸ bookmark".
share_label() { # path src
  local bm; bm="$(wc_label "$1")"
  if group_members "$2" | awk -F'\t' '$2 == "source" { f = 1 } END { exit !f }'; then
    echo "↳ $(short_name "$bm" "$(name_budget 2)")"
  else
    local repo; repo="$(basename "$2")"
    echo "$repo ▸ $(short_name "$bm" "$(name_budget $(( ${#repo} + 3 )))")"
  fi
}
is_generated_label() { case "$1" in "↳ "*|*" ▸ "*) return 0 ;; *) return 1 ;; esac; }

focus_flag() { [ "${HGWT_FOCUS:-1}" = 1 ] && echo --focus || echo --no-focus; }

# --- core operations (shared by CLI and popups) ------------------------------

core_open() { # path src [label] -> prints workspace id
  local path="$1" src="$2" label="${3:-}" ws
  ws="$(ws_for_path "$path")"
  if [ -n "$ws" ]; then
    [ "${HGWT_FOCUS:-1}" = 1 ] && herdr workspace focus "$ws" >/dev/null
    [ -z "$label" ] || herdr workspace rename "$ws" "$label" >/dev/null 2>&1 || true
    echo "$ws"; return 0
  fi
  if [ -n "$label" ]; then :   # custom labels aren't "generated", so relabeling leaves them alone
  elif [ "$path" = "$src" ]; then label="$(basename "$src")"; else label="$(share_label "$path" "$src")"; fi
  ws="$(herdr workspace create --cwd "$path" --label "$label" "$(focus_flag)" |
        jq -r '.result.workspace.workspace_id // empty')"
  [ -n "$ws" ] || { warn "workspace create failed"; return 1; }
  if [ "$path" = "$src" ]; then relabel_all; else regroup "$ws" "$src"; fi
  refresh_ws "$ws" "$path" cache || true
  run_pending_setup "$ws" "$path" "$src"
  echo "$ws"
}

# src name base(empty = "." of src, or the existing bookmark/branch) [path] -> prints path.
# An existing bookmark is checked out, then an existing named branch; otherwise
# a new bookmark (or named branch, HG_NEW_BRANCH=branch) is started at base.
core_create() {
  local src="$1" name="$2" base="${3:-}" dest="${4:-}"
  [ -n "$name" ] || { warn "bookmark name required"; return 1; }
  if [ -z "$dest" ] && dest="$(find_share "$src" "$name")"; then echo "$dest"; return 0; fi
  if [ -n "$dest" ]; then
    case "$dest" in /*) ;; *) dest="$PWD/$dest" ;; esac
    if [ -d "$dest" ] && is_share_of "$(cd "$dest" && pwd -P)" "$src"; then (cd "$dest" && pwd -P); return 0; fi
  else
    dest="$(share_dest "$src" "$name")"
  fi
  [ ! -e "$dest" ] || { warn "$dest exists and is not a share of $src"; return 1; }
  mkdir -p "$(dirname "$dest")"
  local share_args=(-U); [ "$SHARE_BOOKMARKS" = 1 ] && share_args+=(-B)
  hg --config extensions.share= share -q "${share_args[@]}" "$src" "$dest" || { warn "hg share failed"; return 1; }
  # shared bookmarks only resolve with the extension loaded; enable it per-share
  printf '[extensions]\nshare =\n' >>"$dest/.hg/hgrc"
  if [ -z "$base" ] && bm_exists "$src" "$name"; then
    hg -R "$dest" update -q -r "$name" || { warn "update to $name failed"; return 1; }
  elif [ -z "$base" ] && branch_exists "$src" "$name"; then
    hg -R "$dest" update -q -r "max(branch('literal:$name') and head())" || { warn "update to branch $name failed"; return 1; }
  else
    hg -R "$dest" update -q -r "${base:-$(hg -R "$src" log -r . -T '{node}')}" ||
      { warn "update failed (share left at $dest)"; return 1; }
    if [ "$NEW_KIND" = branch ]; then
      hg -R "$dest" branch -q "$name" || { warn "hg branch failed (share left at $dest)"; return 1; }
    else
      hg -R "$dest" bookmark "$name" || { warn "bookmark failed (share left at $dest)"; return 1; }
      own_bm "$src" "$name"
    fi
  fi
  dest="$(cd "$dest" && pwd -P)"
  [ "$dest" = "$(cd "$(share_dest "$src" "$name")" 2>/dev/null && pwd -P)" ] ||
    grep -qxF -- "$dest" "$(extra_file "$src")" 2>/dev/null || printf '%s\n' "$dest" >>"$(extra_file "$src")"
  bootstrap "$src" "$dest"
  echo "$dest"
}

# --- new-share bootstrap -----------------------------------------------------
# Copy untracked files (HGWT_COPY, .hgwt-copy, .hg/hgwt-copy globs, relative to
# the source root) into a fresh share, never overwriting. Copies are listed in
# the share's .hg/hgwt-copied so removal doesn't count them as unsaved work.

copy_globs() { # src -> one glob per line
  local f
  for f in $COPY_GLOBS; do printf '%s\n' "$f"; done
  for f in "$1/.hgwt-copy" "$1/.hg/hgwt-copy"; do
    [ -f "$f" ] && sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$f" | grep . || true
  done
}

bootstrap() { # src dest
  local src="$1" dest="$2" g m n=0
  while IFS= read -r g; do
    case "$g" in /*|..|../*|*/../*) warn "skipping copy pattern outside the repo: $g"; continue ;; esac
    while IFS= read -r m; do
      [ -n "$m" ] && [ -e "$src/$m" ] && [ ! -e "$dest/$m" ] || continue
      mkdir -p "$(dirname "$dest/$m")" && cp -Rp "$src/$m" "$dest/$m" &&
        printf '%s\n' "$m" >>"$dest/.hg/hgwt-copied" && n=$((n + 1))
    done < <(cd "$src" && shopt -s nullglob dotglob && for m in $g; do printf '%s\n' "$m"; done)
  done < <(copy_globs "$src")
  [ $n = 0 ] || warn "copied $n file(s) from $(basename "$src")"
  # the setup script runs in the new workspace (see core_open), so its output is visible there
  [ ! -x "$src/.hg/hgwt-setup" ] || touch "$dest/.hg/hgwt-setup-pending"
}

run_pending_setup() { # ws path src
  local p f="$2/.hg/hgwt-setup-pending"
  [ -f "$f" ] || return 0
  rm -f "$f"
  p="$(herdr pane list 2>/dev/null | jq -r --arg w "$1" '[.result.panes[]? | select(.workspace_id == $w)][0].pane_id // empty')"
  [ -n "$p" ] || { warn "no pane to run $3/.hg/hgwt-setup in"; return 0; }
  herdr pane run "$p" "HGWT_SOURCE=$(printf %q "$3") HGWT_SHARE=$(printf %q "$2") $(printf %q "$3/.hg/hgwt-setup")" >/dev/null 2>&1 ||
    warn "couldn't start $3/.hg/hgwt-setup"
}

# Untracked file in a share that is an unchanged copy from bootstrap.
copied_unchanged() { # share src file
  local e
  while IFS= read -r e; do
    case "$3" in "$e"|"$e"/*) cmp -s "$1/$3" "$2/$3" && return 0 ;; esac
  done <"$1/.hg/hgwt-copied"
  return 1
}

share_dirty() { hg -R "$1" status -mard 2>/dev/null | wc -l | tr -d ' '; }
# what removing a checkout would lose: uncommitted changes plus untracked (not ignored) files
share_unsaved() {
  local src line n=0
  [ -s "$1/.hg/hgwt-copied" ] || { hg -R "$1" status -mardu 2>/dev/null | wc -l | tr -d ' '; return; }
  src="$(source_of_root "$1")"
  while IFS= read -r line; do
    if [ "${line%% *}" = "?" ] && copied_unchanged "$1" "$src" "${line#? }"; then continue; fi
    n=$((n + 1))
  done < <(hg -R "$1" status -mardu 2>/dev/null)
  echo $n
}
# the lines share_unsaved counts, for showing before a discard
unsaved_list() {
  local src line
  src="$(source_of_root "$1")"
  hg -R "$1" status -mardu 2>/dev/null | while IFS= read -r line; do
    if [ -s "$1/.hg/hgwt-copied" ] && [ "${line%% *}" = "?" ] && copied_unchanged "$1" "$src" "${line#? }"; then continue; fi
    printf '%s\n' "$line"
  done
}

# --- bookmark hygiene --------------------------------------------------------
# Bookmarks this plugin created are listed in the source repo's .hg, so cleanup
# only ever deletes what it made (never `main`, or a bookmark you checked out).

owned_file() { printf '%s/.hg/herdr-hg-bookmarks\n' "$1"; }
owned_bms() { cat "$(owned_file "$1")" 2>/dev/null || true; }
is_owned_bm() { grep -qxF -- "$2" "$(owned_file "$1")" 2>/dev/null; }
own_bm() { is_owned_bm "$1" "$2" || printf '%s\n' "$2" >>"$(owned_file "$1")"; }
disown_bm() {
  local f; f="$(owned_file "$1")"; [ -f "$f" ] || return 0
  grep -vxF -- "$2" "$f" >"$f.tmp" || true
  if [ -s "$f.tmp" ]; then mv "$f.tmp" "$f"; else rm -f "$f.tmp" "$f"; fi
}
bm_exists() { hg -R "$1" log -r "bookmark('$2')" -T x >/dev/null 2>&1; }
active_bm() { hg -R "$1" log -r . -T '{activebookmark}' 2>/dev/null || true; }
checkouts() { printf '%s\n' "$1"; hg_shares "$1" | cut -f1; }
bm_in_use() { # src bookmark except-path: active in another checkout?
  local p
  while IFS= read -r p; do
    if [ "$p" != "$3" ] && [ "$(active_bm "$p")" = "$2" ]; then return 0; fi
  done < <(checkouts "$1")
  return 1
}

# Revset of the work only $2 holds: reachable from it but not public, not in
# another bookmark, and not obsolete (rebased/landed elsewhere). Empty = landed.
unlanded_revs() { # repo rev-expr own-bookmark
  local others="public()" b
  while IFS= read -r b; do
    [ -n "$b" ] && [ "$b" != "$3" ] || continue
    case "$b" in *"'"*|*\\*) continue ;; esac
    others="$others or bookmark('$b')"
  done < <(hg -R "$1" bookmarks -T '{bookmark}\n' 2>/dev/null)
  printf 'only(%s, %s) - obsolete()\n' "$2" "$others"
}
# -1 when hg can't tell (bad revset, unreadable repo): callers treat that as "not landed".
unlanded_count() {
  local out; out="$(hg -R "$1" log -r "$(unlanded_revs "$@")" -T x 2>/dev/null)" || { echo -1; return; }
  printf '%s\n' "${#out}"
}
commits_word() { if [ "$1" -ge 0 ]; then echo "$1 commit(s)"; else echo "an unknown number of commits"; fi; }

# Delete bookmark $3 and strip the commits only it holds. Refuses if another
# checkout is on them. hg keeps a backup bundle in the source's .hg/strip-backup.
strip_bm() { # src path bookmark
  local src="$1" path="$2" bm="$3" set p roots=() n
  set="$(unlanded_revs "$path" "bookmark('$bm')" "$bm")"
  while IFS= read -r p; do
    [ "$p" != "$path" ] || continue
    # other checkouts may not see the bookmark, so compare by node here
    n="$(hg -R "$p" log -r . -T '{node}' 2>/dev/null)" || continue
    if [ -n "$(hg -R "$path" log -r "$n and descendants($set)" -T x 2>/dev/null)" ]; then
      warn "not stripping $bm: ${p/#$HOME/~} has those commits checked out"; return 1
    fi
  done < <(checkouts "$src")
  while IFS= read -r n; do roots+=(-r "$n"); done < <(hg -R "$path" log -r "roots($set)" -T '{node}\n')
  hg -R "$path" bookmark -q -d "$bm" && disown_bm "$src" "$bm"
  # from the source repo, so the backup bundle outlives the share
  [ ${#roots[@]} -eq 0 ] || hg -R "$src" debugstrip -q "${roots[@]}" || { warn "strip failed"; return 1; }
  warn "stripped $bm (backup in ${src/#$HOME/~}/.hg/strip-backup)"
}

core_remove() { # path src force(0|1) strip(0|1); returns 3 when unsaved work and not forced
  local path="$1" src="$2" force="${3:-0}" strip="${4:-0}" ws bm n
  is_share_of "$path" "$src" || { warn "refusing: $path is not a share of $src"; return 1; }
  if [ "$force" != 1 ] && [ "$(share_unsaved "$path")" -gt 0 ]; then return 3; fi
  # Bookmark first: everything below can kill this popup (it may live in $path's workspace).
  bm="$(active_bm "$path")"
  if [ -n "$bm" ] && is_owned_bm "$src" "$bm" && ! bm_in_use "$src" "$bm" "$path"; then
    n="$(unlanded_count "$path" "bookmark('$bm')" "$bm")"
    if [ "$n" -eq 0 ]; then
      hg -R "$path" bookmark -q -d "$bm" && disown_bm "$src" "$bm" && warn "deleted bookmark $bm (landed)"
    elif [ "$strip" = 1 ] && [ "$n" -gt 0 ]; then
      strip_bm "$src" "$path" "$bm" || return 1
    else
      warn "kept bookmark $bm: $(commits_word "$n") not landed$([ "$n" -gt 0 ] && echo ' (--strip discards them)')"
    fi
  fi
  ws="$(ws_for_path "$path")"
  rm -rf -- "$path" "$(remote_dir "$path")"
  unrecord_share "$src" "$path"
  if [ "$(dirname "$path")" = "$WT_ROOT/$(basename "$src")" ]; then rmdir "$(dirname "$path")" 2>/dev/null || true; fi
  [ -z "$ws" ] || herdr workspace close "$ws" >/dev/null || true
}

# Shares safe to remove without asking: no unsaved files, nothing unlanded.
# "path\tlabel"; open ones only with include_open=1.
prune_candidates() { # src include_open(0|1)
  local p b
  while IFS=$'\t' read -r p b; do
    if [ "$2" != 1 ] && [ -n "$(ws_for_path "$p")" ]; then continue; fi
    [ "$(share_unsaved "$p")" -eq 0 ] || continue
    [ "$(unlanded_count "$p" . "$(active_bm "$p")")" -eq 0 ] || continue
    printf '%s\t%s\n' "$p" "$b"
  done < <(hg_shares "$1")
}

# Owned bookmarks no checkout uses: "bookmark\tlanded|gone|N" (N = unlanded commits)
orphan_bms() { # src
  local b n
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    if ! bm_exists "$1" "$b"; then printf '%s\tgone\n' "$b"; continue; fi
    bm_in_use "$1" "$b" "" && continue
    n="$(unlanded_count "$1" "bookmark('$b')" "$b")"
    if [ "$n" -eq 0 ]; then printf '%s\tlanded\n' "$b"; else printf '%s\t%s\n' "$b" "$n"; fi
  done < <(owned_bms "$1")
}

core_prune() { # src include_open(0|1) dry_run(0|1)
  local src="$1" p b s n=0
  if [ "$3" != 1 ] && [ -f "$(extra_file "$src")" ]; then  # forget --path shares deleted by hand
    while IFS= read -r p; do [ -d "$p" ] || unrecord_share "$src" "$p"; done <"$(extra_file "$src")"
  fi
  while IFS=$'\t' read -r p b; do
    n=$((n + 1))
    if [ "$3" = 1 ]; then warn "would remove share ${p/#$HOME/~} ($b)"
    else warn "removing share ${p/#$HOME/~} ($b)"; core_remove "$p" "$src" 0 0 || true; fi
  done < <(prune_candidates "$src" "$2")
  while IFS=$'\t' read -r b s; do
    case "$s" in
      gone) n=$((n + 1)); [ "$3" = 1 ] || disown_bm "$src" "$b" ;;
      landed)
        n=$((n + 1))
        if [ "$3" = 1 ]; then warn "would delete bookmark $b (landed)"
        else hg -R "$src" bookmark -q -d "$b" && disown_bm "$src" "$b" && warn "deleted bookmark $b (landed)"; fi ;;
      *) warn "keeping bookmark $b: $(commits_word "$s") not landed (hgwt open --bookmark $b to finish it)" ;;
    esac
  done < <(orphan_bms "$src")
  [ $n -gt 0 ] || warn "nothing to clean up"
}

core_close_group() { # src -> closes shares then source workspace
  local ws role p members
  members="$(group_members "$1")"
  [ -n "$members" ] || { warn "no open workspaces for $1"; return 0; }
  while IFS=$'\t' read -r ws role p; do
    if [ "$role" = share ]; then herdr workspace close "$ws" >/dev/null || true; fi
  done <<<"$members"
  while IFS=$'\t' read -r ws role p; do
    if [ "$role" = source ]; then herdr workspace close "$ws" >/dev/null || true; fi
  done <<<"$members"
}

# Re-label/regroup every open share workspace (after a source opened/closed).
relabel_all() {
  local ws c r src cur want
  while IFS=$'\t' read -r ws c; do
    [ -n "$c" ] && [ "$(vcs_of "$c")" = hg ] || continue
    r="$(hg_root "$c")"; src="$(source_of_root "$r")"
    [ -n "$src" ] && [ "$src" != "$r" ] || continue
    cur="$(ws_label "$ws")"; is_generated_label "$cur" || continue
    want="$(share_label "$r" "$src")"
    [ "$cur" = "$want" ] || herdr workspace rename "$ws" "$want" >/dev/null 2>&1 || true
    regroup "$ws" "$src"
  done < <(ws_map)
}

# --- remote (incoming) cache ---------------------------------------------------

ck() { printf '%s' "$1" | cksum | awk '{ print $1 }'; }
remote_dir() { printf '%s/remote/%s\n' "$CACHE" "$(ck "$1")"; }       # per checkout, removed with it
remote_file() { printf '%s/%s\n' "$(remote_dir "$1")" "$(ck "$2")"; }

# Prints cached incoming count for root $1 / label $2 ("" if unknown).
remote_cached() { local f; f="$(remote_file "$1" "$2")"; [ -f "$f" ] && awk '{ print $2 }' "$f" || true; }
remote_stale() {
  local f t; f="$(remote_file "$1" "$2")"
  [ "$REMOTE_MINUTES" -gt 0 ] || return 1
  [ -f "$f" ] || return 0
  t="$(awk '{ print $1 }' "$f")"
  [ $(( $(date +%s) - t )) -ge $(( REMOTE_MINUTES * 60 )) ]
}
remote_fetch() { # root label -> writes cache "epoch count|-"
  local r="$1" bm="$2" out n rc f
  f="$(remote_file "$r" "$bm")"; mkdir -p "$(dirname "$f")"
  if ! hg -R "$r" paths default >/dev/null 2>&1; then echo "$(date +%s) -" >"$f"; return; fi
  set +e
  out="$(with_timeout "$REMOTE_TIMEOUT" hg -R "$r" incoming -q -T x --config ui.interactive=false -r "$bm" </dev/null 2>/dev/null)"; rc=$?
  if [ $rc -gt 1 ]; then  # bookmark unknown on remote -> compare named branch instead
    out="$(with_timeout "$REMOTE_TIMEOUT" hg -R "$r" incoming -q -T x --config ui.interactive=false \
           -b "$(hg -R "$r" log -r . -T '{branch}')" </dev/null 2>/dev/null)"; rc=$?
  fi
  set -e
  if [ $rc -le 1 ]; then n=${#out}; else n=-; fi
  echo "$(date +%s) $n" >"$f"
}

# --- sidebar tokens ----------------------------------------------------------

# herdr cuts long sidebar text at the end, which loses the part of a bookmark
# that usually tells shares apart (a ticket number). So shorten it ourselves:
# drop HG_BOOKMARK_STRIP, then keep the start and the end around an ellipsis.
sidebar_cols() {
  local n
  n="$(grep -E '^[[:space:]]*sidebar_width[[:space:]]*=' "${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml" 2>/dev/null |
       head -n 1 | tr -dc 0-9)"
  echo "${n:-26}"
}
# Does $hg_status sit on the same sidebar row as $hg_bookmark? (setup's default does)
status_shares_row() {
  grep -o '\[[^][]*\$hg_bookmark[^][]*\]' "${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml" 2>/dev/null |
    grep -q '\$hg_status'
}
name_budget() { # columns already used on the row -> max name length (0 = no limit)
  case "$BM_MAX" in
    auto) local b=$(( $(sidebar_cols) - 7 - $1 )); [ $b -ge 5 ] || b=5; echo $b ;;
    *[!0-9]*|'') echo 0 ;;
    *) echo "$BM_MAX" ;;
  esac
}
short_name() { # name max
  local s="$1" max="$2" head tail d
  if [ -n "$BM_STRIP" ]; then
    d="$(printf '\001')"; s="$(printf '%s' "$s" | sed -E "s$d$BM_STRIP$d$d")"; [ -n "$s" ] || s="$1"
  fi
  if [ "$max" -gt 0 ] && [ ${#s} -gt "$max" ]; then
    head=$(( (max - 1) * 2 / 5 )); tail=$(( max - 1 - head ))
    s="${s:0:$head}…${s:${#s}-$tail}"
  fi
  printf '%s\n' "$s"
}

# "!op", "!op:N" or "!N": an interrupted rebase/merge/etc. and/or N unresolved files.
blocked_status() {
  local r="$1" op="" kv n
  for kv in rebase:rebasestate histedit:histedit-state graft:graftstate unshelve:shelvedstate \
            evolve:evolvestate update:updatestate; do
    if [ -e "$r/.hg/${kv#*:}" ]; then op="${kv%%:*}"; break; fi
  done
  if [ -z "$op" ] && [ -n "$(hg -R "$r" log -r 'p2()' -T x 2>/dev/null)" ]; then op=merge; fi
  n="$(hg -R "$r" resolve -l 2>/dev/null | grep -c '^U ' || true)"
  if [ -n "$op" ] && [ "$n" -gt 0 ]; then echo "!$op:$n"
  elif [ -n "$op" ]; then echo "!$op"
  elif [ "$n" -gt 0 ]; then echo "!$n"; fi
}

refresh_ws() { # ws [cwd] [remote mode: auto|force|cache]
  local ws="$1" cwd="${2:-}" mode="${3:-cache}" r bm draft dirty inc status src cur want
  [ -n "$ws" ] || return 0
  [ -n "$cwd" ] || cwd="$(ws_cwd "$ws")"
  if [ -z "$cwd" ] || [ "$(vcs_of "$cwd")" != hg ]; then
    herdr workspace report-metadata "$ws" --source "$SOURCE" \
      --clear-token hg_bookmark --clear-token hg_status >/dev/null 2>&1 || true
    return 0
  fi
  r="$(hg_root "$cwd")"
  bm="$(wc_label "$r")"
  case "$mode" in
    force) remote_fetch "$r" "$bm" ;;
    auto) if remote_stale "$r" "$bm"; then remote_fetch "$r" "$bm"; fi ;;
  esac
  draft="$(hg -R "$r" log -r 'only(., public())' -T x 2>/dev/null | wc -c | tr -d ' ')"
  dirty="$(share_dirty "$r")"
  inc="$(remote_cached "$r" "$bm")"
  status="$(blocked_status "$r")"
  [ "${draft:-0}" -gt 0 ] && status="${status:+$status }↑$draft"
  case "$inc" in ''|-|0) ;; *) status="${status:+$status }↓$inc" ;; esac
  [ "${dirty:-0}" -gt 0 ] && status="${status:+$status }*$dirty"
  local used=0 shown
  if [ -n "$status" ] && status_shares_row; then used=$(( ${#status} + 3 )); fi
  shown="$(short_name "$bm" "$(name_budget $used)")"
  if [ -n "$status" ]; then
    herdr workspace report-metadata "$ws" --source "$SOURCE" \
      --token "hg_bookmark=$shown" --token "hg_status=$status" >/dev/null
  else
    herdr workspace report-metadata "$ws" --source "$SOURCE" \
      --token "hg_bookmark=$shown" --clear-token hg_status >/dev/null
  fi
  # keep generated share labels in sync with the bookmark
  src="$(source_of_root "$r")"
  if [ -n "$src" ] && [ "$src" != "$r" ]; then
    cur="$(ws_label "$ws")"
    if is_generated_label "$cur"; then
      want="$(share_label "$r" "$src")"
      [ "$cur" = "$want" ] || herdr workspace rename "$ws" "$want" >/dev/null 2>&1 || true
    fi
  fi
}

event_ws() {
  jq -r '([.. | objects | .workspace_id? // empty] | .[0])
         // ([.. | objects | .pane_id? // empty] | .[0] // empty | sub(":.*$"; ""))
         // empty' <<<"${HERDR_PLUGIN_EVENT_JSON:-{\}}" 2>/dev/null || true
}

cmd_refresh() {
  local what="${1:-}" arg="${2:-}" mode=cache ws c src
  for a in "$@"; do case "$a" in auto|force|cache) mode="$a" ;; esac; done
  case "$what" in
    --all)
      while IFS=$'\t' read -r ws c; do refresh_ws "$ws" "$c" "$mode" || true; done < <(ws_map) ;;
    --event)
      case "${HERDR_PLUGIN_EVENT:-}" in
        workspace.closed|workspace.created)   # a source opening/closing changes share labels
          relabel_all
          if [ "${HERDR_PLUGIN_EVENT:-}" = workspace.created ]; then refresh_ws "$(event_ws)" "" cache; fi ;;
        pane.agent_status_changed)
          if jq -e '[.. | strings] | any(. == "idle" or . == "done" or . == "blocked")' \
               <<<"${HERDR_PLUGIN_EVENT_JSON:-{\}}" >/dev/null 2>&1; then refresh_ws "$(event_ws)" "" cache; fi ;;
        *) refresh_ws "$(event_ws)" "" auto ;;
      esac ;;
    --workspace) refresh_ws "$arg" "" "$mode" ;;
    --pane) # from the shell's cd hook: herdr has no cwd-changed event. $3 is the new dir.
      local pl dir="${3:-}"
      pl="$(herdr pane list 2>/dev/null)" || exit 0
      ws="$(jq -r --arg p "$arg" '.result.panes[]? | select(.pane_id == $p) | .workspace_id' <<<"$pl")"
      [ -n "$ws" ] || exit 0
      # the sidebar follows the pane ws_map picks (focused, else first); herdr may not
      # have seen the new cwd yet, so use the one the shell passed for that pane
      if [ -n "$dir" ] && [ "$(jq -r --arg w "$ws" '[.result.panes[]? | select(.workspace_id == $w)]
           | (map(select(.focused)) + .) | .[0].pane_id // empty' <<<"$pl")" = "$arg" ]; then
        refresh_ws "$ws" "$dir" cache
      else
        refresh_ws "$ws" "" cache
      fi ;;
    --cwd) # from ~/.hgrc hooks; the hg command may target any repo (hg -R, cd), so
           # refresh whichever workspaces have that repo open. pull/push refetch remote.
      [ -n "${HERDR_ENV:-}${HERDR_WORKSPACE_ID:-}" ] || exit 0
      case "${HG_TXNNAME:-}" in pull*|push*|unbundle*) mode=force ;; esac
      local r; r="$(hg_root "$arg" 2>/dev/null)" || exit 0
      while IFS=$'\t' read -r ws c; do
        [ -n "$c" ] || continue
        if [ "$c" = "$r" ] || case "$c" in "$r"/*) true ;; *) false ;; esac; then refresh_ws "$ws" "$c" "$mode" || true; fi
      done < <(ws_map) ;;
    *) refresh_ws "$(current_ws)" "" "$mode" ;;
  esac
}

# --- popup UI ----------------------------------------------------------------

pause() { printf '\n%s' "${1:-Press enter to close…}"; read -r _ <&3 || true; }
ask() { printf '%s' "$1" >&2; local a; read -r a <&3 || true; printf '%s\n' "$a"; }

# Numbered picker over stdin lines "value\tdisplay"; echoes chosen value.
pick() {
  local lines=() line n i choice
  while IFS= read -r line; do lines+=("$line"); done
  n=${#lines[@]}
  if [ "$n" -eq 0 ]; then echo "  (none)" >&2; pause; return 1; fi
  i=1
  for line in "${lines[@]}"; do printf '  %2d) %s\n' "$i" "${line#*$'\t'}" >&2; i=$((i + 1)); done
  printf '\nChoose [1-%d, empty to cancel]: ' "$n" >&2
  read -r choice <&3 || return 1
  case "$choice" in ''|*[!0-9]*) return 1 ;; esac
  [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ] || return 1
  line="${lines[$((choice - 1))]}"; printf '%s\n' "${line%%$'\t'*}"
}

share_menu() { # src, with_source(0|1) -> picker lines
  [ "$2" = 1 ] && printf '%s\t%s  (source)%s\n' "$1" "$(basename "$1")" "$([ -n "$(ws_for_path "$1")" ] && echo '  [open]')"
  hg_shares "$1" | while IFS=$'\t' read -r p b; do
    printf '%s\t%s  %s%s\n' "$p" "$b" "${p/#$HOME/~}" "$([ -n "$(ws_for_path "$p")" ] && echo '  [open]')"
  done
}

ui_new() {
  local cwd vcs src name base dest
  cwd="$(current_cwd)"; vcs="$(vcs_of "$cwd")"
  case "$vcs" in
    none) echo "Not inside an hg or git repository: $cwd"; pause; return ;;
    git)
      echo "git repo: $(git -C "$cwd" rev-parse --show-toplevel)"
      name="$(ask 'Branch: ')"; [ -n "$name" ] || return 0
      base="$(ask 'Base ref [HEAD]: ')"
      herdr worktree create --cwd "$cwd" --branch "$name" ${base:+--base "$base"} --focus >/dev/null \
        || pause "git worktree create failed — enter to close…"
      return ;;
  esac
  src="$(hg_source_root "$cwd")"
  echo "hg repo: ${src/#$HOME/~}"
  name="$(ask 'Bookmark: ')"; [ -n "$name" ] || return 0
  if find_share "$src" "$name" >/dev/null; then
    echo "Share for $name already exists, opening it."
  elif bm_exists "$src" "$name"; then
    echo "Bookmark exists; the share will check it out."
  elif branch_exists "$src" "$name"; then
    echo "Named branch exists; the share will check out its head."
  else
    base="$(ask 'Base revision [.]: ')"
    [ -z "$base" ] || [ "$base" = . ] && base="$(hg -R "$(hg_root "$cwd")" log -r . -T '{node}')"
  fi
  dest="$(core_create "$src" "$name" "${base:-}")" || { pause "Failed — enter to close…"; return; }
  core_open "$dest" "$src" >/dev/null || pause "Failed — enter to close…"
}

ui_open() {
  local cwd vcs src path
  cwd="$(current_cwd)"; vcs="$(vcs_of "$cwd")"
  case "$vcs" in
    none) echo "Not inside an hg or git repository: $cwd"; pause; return ;;
    git)
      echo "git worktrees:"
      path="$(herdr worktree list --cwd "$cwd" | jq -r '
          .result.worktrees[]? | "\(.path)\t\(.branch // "(detached)")  \(.path)"' | pick)" || return 0
      herdr worktree open --cwd "$cwd" --path "$path" --focus >/dev/null || pause "open failed…"
      return ;;
  esac
  src="$(hg_source_root "$cwd")"
  echo "hg shares of ${src/#$HOME/~}:"
  path="$(share_menu "$src" 1 | pick)" || return 0
  core_open "$path" "$src" >/dev/null || pause "Failed — enter to close…"
}

ui_remove() {
  local cwd vcs src path r rc ans
  cwd="$(current_cwd)"; vcs="$(vcs_of "$cwd")"
  case "$vcs" in
    none) echo "Not inside an hg or git repository: $cwd"; pause; return ;;
    git)
      ans="$(ask "Remove git worktree for workspace $(current_ws)? [y/N] ")"; [ "$ans" = y ] || return 0
      herdr worktree remove --workspace "$(current_ws)" >/dev/null || pause "remove failed…"
      return ;;
  esac
  src="$(hg_source_root "$cwd")"; r="$(hg_root "$cwd")"
  if [ "$r" != "$src" ]; then
    path="$r"; echo "Current workspace is a share: ${path/#$HOME/~}"
  else
    echo "hg shares of ${src/#$HOME/~}:"
    path="$(share_menu "$src" 0 | pick)" || return 0
  fi
  local force=0 strip=0 bm n
  if [ "$(share_unsaved "$path")" -gt 0 ]; then
    unsaved_list "$path"
    ans="$(ask "$(printf '\n%s uncommitted/untracked file(s) will be lost. Type "discard" to remove anyway: ' "$(share_unsaved "$path")")")"
    [ "$ans" = discard ] || return 0
    force=1
  fi
  bm="$(active_bm "$path")"
  if [ -n "$bm" ] && is_owned_bm "$src" "$bm" && ! bm_in_use "$src" "$bm" "$path"; then
    n="$(unlanded_count "$path" "bookmark('$bm')" "$bm")"
    if [ "$n" -eq 0 ]; then
      echo "Bookmark $bm has landed; it will be deleted too."
    elif [ "$n" -lt 0 ]; then
      echo "Can't tell whether bookmark $bm has landed; it will be kept."
    else
      printf '\nOnly bookmark %s holds these %s commit(s):\n' "$bm" "$n"
      hg -R "$path" log -r "$(unlanded_revs "$path" "bookmark('$bm')" "$bm")" -T '  {node|short} {desc|firstline}\n'
      ans="$(ask "$(printf '\nEnter keeps the bookmark (reopen it later). Type "strip" to delete them: ')")"
      [ "$ans" = strip ] && strip=1
    fi
  fi
  if [ $force = 0 ] && [ $strip = 0 ]; then
    ans="$(ask "Remove share ${path/#$HOME/~}? [y/N] ")"; [ "$ans" = y ] || return 0
  fi
  set +e; core_remove "$path" "$src" 1 "$strip"; rc=$?; set -e
  [ $rc = 0 ] || pause "Failed — enter to close…"
}

# Lines describing what core_prune would do (empty when nothing).
prune_preview() { # src include_open
  local p b s
  while IFS=$'\t' read -r p b; do printf '  remove share   %s (%s)\n' "${p/#$HOME/~}" "$b"; done < <(prune_candidates "$1" "$2")
  while IFS=$'\t' read -r b s; do
    case "$s" in
      landed) printf '  delete bookmark %s (landed)\n' "$b" ;;
      gone) ;;
      *) printf '  keep bookmark   %s (%s not landed)\n' "$b" "$(commits_word "$s")" ;;
    esac
  done < <(orphan_bms "$1")
}

ui_prune() {
  local cwd src preview ans
  cwd="$(current_cwd)"
  [ "$(vcs_of "$cwd")" = hg ] || { echo "Not inside an hg repository: $cwd"; pause; return; }
  src="$(hg_source_root "$cwd")"
  echo "Clean up ${src/#$HOME/~} (closed shares with no unsaved files and nothing unlanded):"
  preview="$(prune_preview "$src" 0)"
  if ! grep -qE '^  (remove|delete)' <<<"$preview"; then printf '%s\n  nothing to remove\n' "$preview" | grep .; pause; return; fi
  printf '%s\n' "$preview"
  ans="$(ask $'\nGo ahead? [y/N] ')"; [ "$ans" = y ] || return 0
  core_prune "$src" 0 0; pause
}

ui_close_group() {
  local cwd src members n ans preview
  cwd="$(current_cwd)"
  [ "$(vcs_of "$cwd")" = hg ] || { echo "Not inside an hg repository (for git use: herdr workspace close --group)"; pause; return; }
  src="$(hg_source_root "$cwd")"; members="$(group_members "$src")"
  n="$(printf '%s\n' "$members" | grep -c . || true)"
  echo "Open workspaces for ${src/#$HOME/~}:"
  while IFS=$'\t' read -r ws role p; do printf '  %-4s %-7s %s\n' "$ws" "$role" "${p/#$HOME/~}"; done <<<"$members"
  ans="$(ask "$(printf '\nClose these %s workspace(s)? Running processes in them stop; files stay. [y/N] ' "$n")")"
  [ "$ans" = y ] || return 0
  # Offer cleanup before closing: closing may take this popup with it.
  preview="$(prune_preview "$src" 1)"
  if grep -qE '^  (remove|delete)' <<<"$preview"; then
    printf '\nAlso clean up?\n%s\n' "$preview"
    ans="$(ask $'\nRemove/delete the above? [y/N] ')"
    [ "$ans" != y ] || core_prune "$src" 1 0
  fi
  core_close_group "$src"
}

# --- details popup / hgwt info ---------------------------------------------------
# Everything the sidebar can't fit. Local only, unless fetch=1 (incoming list).

remote_age() { # root label -> "N min ago" for the cached incoming check, or empty
  local f t; f="$(remote_file "$1" "$2")"; [ -f "$f" ] || return 0
  t="$(awk '{ print $1 }' "$f")"; echo "$(( ($(date +%s) - t) / 60 )) min ago"
}

cmd_info() { # dir fetch(0|1)
  local r="$(hg_root "$1")" fetch="${2:-0}" src bm br n p2 inc age x
  src="$(source_of_root "$r")"; bm="$(active_bm "$r")"; br="$(hg -R "$r" branch 2>/dev/null)"
  H() { printf '\n\033[1m%s\033[0m\n' "$1"; }
  kv() { [ -z "$2" ] || printf '  %-11s %s\n' "$1" "$2"; }
  more() { # cap list output at $1 lines
    awk -v m="$1" 'NR <= m { print } END { if (NR > m) printf "  … and %d more\n", NR - m }'
  }
  printf '\033[1m%s\033[0m\n' "${r/#$HOME/~}"
  if [ "$r" = "$src" ]; then kv repo "source repo"; else kv repo "share of ${src/#$HOME/~}"; fi
  x=""
  if [ -n "$bm" ] && is_owned_bm "$src" "$bm"; then
    n="$(unlanded_count "$r" "bookmark('$bm')" "$bm")"
    if [ "$n" -eq 0 ]; then x="  (made by hgwt, landed: removing the share deletes it)"
    else x="  (made by hgwt, $(commits_word "$n") not landed elsewhere)"; fi
  fi
  kv bookmark "${bm:-(none active)}$x"
  kv branch "$br$([ "$(hg -R "$r" log -r . -T '{branch}')" = "$br" ] || echo '  (new, starts with the next commit)')"
  n="$(hg -R "$r" heads -T x "$br" 2>/dev/null | wc -c | tr -d ' ')"
  [ "${n:-0}" -le 1 ] || kv heads "$n heads on $br (hg heads $br)"
  kv topic "$(hg -R "$r" log -r . -T '{topic}' 2>/dev/null || true)"
  x="$(hg -R "$r" log -r . -T '{join(bookmarks, " ")}' 2>/dev/null | tr ' ' '\n' | grep -vxF -- "$bm" | tr '\n' ' ' || true)"
  kv "also here" "$x"
  kv tags "$(hg -R "$r" log -r . -T '{join(tags, "\n")}' 2>/dev/null | grep -vx tip | tr '\n' ' ' || true)"

  H "Working copy parent"
  hg -R "$r" log -r . -T '  {rev}:{node|short}  {phase}\n  {desc|firstline}\n  {author|person} · {date|age} · {date|isodate}\n' 2>/dev/null
  p2="$(hg -R "$r" log -r 'p2()' -T '  merging with {rev}:{node|short} {desc|firstline}\n' 2>/dev/null || true)"
  [ -z "$p2" ] || printf '%s\n' "$p2"
  x="$(hg -R "$r" log -r 'p1(.)' -T '{rev}:{node|short} {desc|firstline}' 2>/dev/null || true)"
  [ -z "$x" ] || printf '  parent of that: %s\n' "$x"

  x="$(blocked_status "$r")"
  if [ -n "$x" ]; then
    H "In progress: $x"
    hg -R "$r" resolve -l 2>/dev/null | sed 's/^/  /' | more 15
    case "$x" in
      '!rebase'*) echo "  hg rebase --continue | --abort" ;;
      '!histedit'*) echo "  hg histedit --continue | --abort" ;;
      '!graft'*) echo "  hg graft --continue | --abort" ;;
      '!unshelve'*) echo "  hg unshelve --continue | --abort" ;;
      '!merge'*) echo "  hg commit to finish, hg update -C . to abandon" ;;
      '!update'*) echo "  hg update to finish the interrupted update" ;;
    esac
  fi

  n="$(share_dirty "$r")"; x="$(hg -R "$r" status -u 2>/dev/null | wc -l | tr -d ' ')"
  H "Changed files (*$n$([ "$x" = 0 ] || echo " · $x untracked"))"
  if [ "$n" -gt 0 ] || [ -n "$(hg -R "$r" status -u 2>/dev/null)" ]; then
    hg -R "$r" status -mardu 2>/dev/null | sed 's/^/  /' | more 15
  else echo "  clean"; fi

  n="$(hg -R "$r" log -r 'only(., public())' -T x 2>/dev/null | wc -c | tr -d ' ')"
  H "Not pushed (↑$n draft)"
  if [ "$n" -gt 0 ]; then
    hg -R "$r" log -r 'reverse(only(., public()))' -T '  {node|short} {desc|firstline} · {date|age}\n' 2>/dev/null | more 10
  else echo "  nothing"; fi

  H "Remote"
  x="$(hg -R "$r" paths 2>/dev/null | sed 's/^/  /')"
  if [ -z "$x" ]; then echo "  no paths configured"
  else
    printf '%s\n' "$x"
    local label; label="$(wc_label "$r")"
    if [ "$fetch" = 1 ]; then
      echo "  checking incoming for ${label}…"
      remote_fetch "$r" "$label"
      x="$(with_timeout "$REMOTE_TIMEOUT" hg -R "$r" incoming -q --config ui.interactive=false -r "$label" \
            -T '  {node|short} {desc|firstline} · {author|person} · {date|age}\n' </dev/null 2>/dev/null || true)"
      [ -n "$x" ] || x="$(with_timeout "$REMOTE_TIMEOUT" hg -R "$r" incoming -q --config ui.interactive=false -b "$br" \
            -T '  {node|short} {desc|firstline} · {author|person} · {date|age}\n' </dev/null 2>/dev/null || true)"
    fi
    inc="$(remote_cached "$r" "$label")"; age="$(remote_age "$r" "$label")"
    case "$inc" in
      '') echo "  incoming: not checked yet" ;;
      -) echo "  incoming: couldn't check (auth, network or no such bookmark/branch) · $age" ;;
      *) echo "  incoming (↓$inc) for $label · checked $age" ;;
    esac
    [ -z "${x:-}" ] || [ "$fetch" != 1 ] || printf '%s\n' "$x" | more 10
  fi

  n="$(hg -R "$r" shelve -l 2>/dev/null | wc -l | tr -d ' ')"
  if [ "${n:-0}" -gt 0 ]; then H "Shelves ($n)"; hg -R "$r" shelve -l 2>/dev/null | sed 's/^/  /' | more 5; fi

  x="$(hg_shares "$src")"
  if [ -n "$x" ] || [ "$r" != "$src" ]; then
    H "Checkouts of $(basename "$src")"
    { printf '%s\t%s\n' "$src" "$(wc_label "$src")"; printf '%s\n' "$x"; } | while IFS=$'\t' read -r p b; do
      [ -n "$p" ] || continue
      printf '  %s %-24s %s%s\n' "$([ "$p" = "$r" ] && echo '▶' || echo ' ')" "$b" "${p/#$HOME/~}" \
        "$([ -n "$(ws_for_path "$p")" ] && echo '  [open]')"
    done
  fi
}

git_info() { # dir: herdr already shows branch/ahead-behind; this adds the rest
  local g; g="$(git -C "$1" rev-parse --show-toplevel)"
  printf '\033[1m%s\033[0m  (git)\n\n' "${g/#$HOME/~}"
  git -C "$g" status -sb | head -n 20 | sed 's/^/  /'
  printf '\n'; git -C "$g" log -1 --format='  %h %s%n  %an · %ar · %ci' 2>/dev/null
  printf '\n'; git -C "$g" remote -v | awk '$3 == "(fetch)"' | sed 's/^/  /'
}

ui_info() {
  local cwd fetch=0 out rows ans
  cwd="$(current_cwd)"
  while :; do
    case "$(vcs_of "$cwd")" in
      hg) out="$(cmd_info "$cwd" "$fetch" 2>&1)" ;;
      git) out="$(git_info "$cwd" 2>&1)"; printf '%s\n' "$out"; pause; return ;;
      *) echo "Not inside an hg or git repository: $cwd"; pause; return ;;
    esac
    [ "$fetch" = 0 ] || refresh_ws "$(current_ws)" "" cache || true   # sidebar picks up the new ↓
    rows="$(tput lines 2>/dev/null || echo 40)"
    printf '\033[H\033[2J'
    if [ "$(printf '%s\n' "$out" | wc -l)" -gt $(( rows - 2 )) ]; then
      printf '%s\n' "$out" | less -R -X   # less takes keys from /dev/tty itself
    else
      printf '%s\n' "$out"
    fi
    ans="$(ask $'\n[f] check incoming now · enter to close: ')"
    [ "$ans" = f ] || return 0
    fetch=1
  done
}

# --- CLI ---------------------------------------------------------------------

parse_cli() { # sets CLI_* vars
  CLI_CWD="$PWD"; CLI_BM=""; CLI_BASE=""; CLI_PATH=""; CLI_FORCE=0; CLI_JSON=0; CLI_STRIP=0; CLI_DRY=0; CLI_PRUNE=0
  CLI_LABEL=""; CLI_FETCH=0; local ws="" 
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) CLI_CWD="$2"; shift ;;
      --bookmark|-b) CLI_BM="$2"; shift ;;
      --base|-r) CLI_BASE="$2"; shift ;;
      --path) CLI_PATH="$2"; shift ;;           # resolved per command: create may name a new dir
      --label) CLI_LABEL="$2"; shift ;;
      --workspace) ws="$2"; shift ;;
      --force|-f) CLI_FORCE=1 ;;
      --json) CLI_JSON=1 ;;
      --strip) CLI_STRIP=1 ;;
      --dry-run|-n) CLI_DRY=1 ;;
      --prune) CLI_PRUNE=1 ;;
      --fetch) CLI_FETCH=1 ;;
      --no-focus) HGWT_FOCUS=0 ;;
      --focus) HGWT_FOCUS=1 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  if [ -n "$ws" ]; then CLI_CWD="$(ws_cwd "$ws")"; [ -n "$CLI_CWD" ] || die "no workspace $ws"; fi
  [ "$(vcs_of "$CLI_CWD")" = hg ] || die "not inside an hg repository: $CLI_CWD (for git use: herdr worktree)"
  CLI_SRC="$(hg_source_root "$CLI_CWD")"
}

cli_target() { # resolve --path/--bookmark/current share
  if [ -n "$CLI_PATH" ]; then (cd "$CLI_PATH" 2>/dev/null && pwd -P) || die "no such directory: $CLI_PATH"
  elif [ -n "$CLI_BM" ]; then find_share "$CLI_SRC" "$CLI_BM" || die "no share for '$CLI_BM'"
  else
    local r; r="$(hg_root "$CLI_CWD")"
    [ "$r" != "$CLI_SRC" ] || die "specify --bookmark or --path"
    echo "$r"
  fi
}

cli() {
  local cmd="$1"; shift; parse_cli "$@"
  case "$cmd" in
    list)
      if [ "$CLI_JSON" = 1 ]; then
        { printf '%s\t%s\n' "$CLI_SRC" "$(wc_label "$CLI_SRC")"; hg_shares "$CLI_SRC"; } |
          while IFS=$'\t' read -r p b; do
            jq -nc --arg p "$p" --arg b "$b" --arg w "$(ws_for_path "$p")" --arg s "$CLI_SRC" \
              '{path: $p, bookmark: $b, source: ($p == $s), workspace_id: (if $w == "" then null else $w end)}'
          done | jq -sc '{source: .[0].path, shares: .[1:], source_workspace_id: .[0].workspace_id}'
      else
        printf '%s\t%s\t(source)\n' "$(wc_label "$CLI_SRC")" "$CLI_SRC"
        hg_shares "$CLI_SRC" | while IFS=$'\t' read -r p b; do
          printf '%s\t%s\t%s\n' "$b" "$p" "$(ws_for_path "$p")"; done
      fi ;;
    create)
      [ -n "$CLI_BM" ] || die "--bookmark required"
      local dest; dest="$(core_create "$CLI_SRC" "$CLI_BM" "$CLI_BASE" "$CLI_PATH")" || exit 1
      core_open "$dest" "$CLI_SRC" "$CLI_LABEL" | jq -Rc --arg p "$dest" '{workspace_id: ., path: $p}' ;;
    open)
      local t; t="$(cli_target)"
      core_open "$t" "$CLI_SRC" "$CLI_LABEL" | jq -Rc --arg p "$t" '{workspace_id: ., path: $p}' ;;
    remove)
      local t rc; t="$(cli_target)"
      set +e; core_remove "$t" "$CLI_SRC" "$CLI_FORCE" "$CLI_STRIP"; rc=$?; set -e
      [ $rc != 3 ] || die "$t has uncommitted changes or untracked files (use --force to discard)"
      exit $rc ;;
    prune) core_prune "$CLI_SRC" 0 "$CLI_DRY" ;;
    info) cmd_info "$CLI_CWD" "$CLI_FETCH" ;;
    close-group)
      [ "$CLI_PRUNE" = 0 ] || core_prune "$CLI_SRC" 1 0
      core_close_group "$CLI_SRC" ;;
  esac
}

# --- main --------------------------------------------------------------------

case "${1:-}" in
  list|create|open|remove|prune|close-group|info) cli "$@" ;;
  action)
    herdr plugin pane open --plugin "$PLUGIN_ID" --entrypoint "${2:?new|open|remove|prune|close-group|info|setup}" >/dev/null ;;
  ui)
    case "${2:-}" in
      new) ui_new ;; open) ui_open ;; remove) ui_remove ;; prune) ui_prune ;; close-group) ui_close_group ;; info) ui_info ;;
      setup) "$(dirname "$0")/hgwt-setup" <&3 || true; pause ;;
      *) die "usage: hgwt ui new|open|remove|prune|close-group|info|setup" ;;
    esac ;;
  refresh) shift; cmd_refresh "$@" ;;
  setup) shift; exec "$(dirname "$0")/hgwt-setup" "$@" ;;
  startup) # herdr startup hook: restore sidebar tokens + grouping, nudge once if not set up
    find "$CACHE/remote" -maxdepth 1 -type f -delete 2>/dev/null || true  # pre-0.3 flat cache
    cmd_refresh --all auto || true
    relabel_all || true
    if ! "$(dirname "$0")/hgwt-setup" --status 2>/dev/null &&
       [ ! -f "$HERDR_PLUGIN_CONFIG_DIR/.setup-dismissed" ]; then
      herdr notification show "hg worktrees: finish setup" \
        --body "Run the 'Set up hg worktrees' action, or: herdr plugin action invoke $PLUGIN_ID.setup" >/dev/null 2>&1 || true
    fi ;;
  -h|--help|help|"") sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (try: hgwt help)" ;;
esac
