#!/usr/bin/env bash
# hgwt-setup — wire herdr-hg into herdr's config.toml, ~/.hgrc and your shell rc. Idempotent.
#
#   hgwt-setup [--yes]        apply (asks first unless --yes)
#   hgwt-setup --uninstall    remove everything setup added
#   hgwt-setup --status       exit 0 if set up, 1 if not
#   hgwt-setup --dismiss      stop the startup "run setup" reminder
#
# Everything added is fenced by "herdr-hg" markers so it can be found and removed.
# Files are backed up to <file>.herdr-hg.bak before each change; if herdr rejects
# the new config, the backup is restored.
set -euo pipefail

PLUGIN_ID="mpzarde.hg-worktree"
BEGIN="# >>> herdr-hg (managed by hgwt-setup; remove with: hgwt-setup --uninstall) >>>"
END="# <<< herdr-hg <<<"
TAG="# herdr-hg"

herdr() { "${HERDR_BIN_PATH:-herdr}" "$@"; }

HERDR_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml"
HGRC="${HGRCPATH_USER:-$HOME/.hgrc}"
# herdr has no "cwd changed" event, so a shell hook refreshes the sidebar on cd
case "${HGWT_SHELL:-$(basename "${SHELL:-}")}" in
  zsh) SHELL_KIND=zsh; SHELLRC="${HGWT_SHELL_RC:-${ZDOTDIR:-$HOME}/.zshrc}" ;;
  bash) SHELL_KIND=bash; SHELLRC="${HGWT_SHELL_RC:-$HOME/.bashrc}" ;;
  *) SHELL_KIND=""; SHELLRC="" ;;
esac
CONFIG_DIR="${HERDR_PLUGIN_CONFIG_DIR:-$(herdr plugin config-dir "$PLUGIN_ID" 2>/dev/null || true)}"
[ -n "$CONFIG_DIR" ] || { echo "hgwt-setup: plugin $PLUGIN_ID is not linked/installed in herdr" >&2; exit 1; }
HOOK="$CONFIG_DIR/hg-hook"
# CLI shim goes in ~/.local/bin (where herdr's installer puts herdr) if it's on PATH
BIN_DIR="${HGWT_BIN_DIR:-$HOME/.local/bin}"
SHIM="$BIN_DIR/hgwt"
SHIM_MARK="# hgwt shim (managed by herdr-hg setup)"

# Keys this plugin wants. Override in $CONFIG_DIR/config.env before running setup.
[ -f "$CONFIG_DIR/config.env" ] && . "$CONFIG_DIR/config.env"
KEY_NEW="${HGWT_KEY_NEW:-prefix+shift+g}"
KEY_OPEN="${HGWT_KEY_OPEN:-prefix+shift+o}"
KEY_REMOVE="${HGWT_KEY_REMOVE:-prefix+shift+y}"
KEY_CLOSE_GROUP="${HGWT_KEY_CLOSE_GROUP:-prefix+shift+c}"
KEY_INFO="${HGWT_KEY_INFO:-prefix+shift+i}"
KEY_GIT_NATIVE="${HGWT_KEY_GIT_NATIVE:-prefix+alt+g}"   # where herdr's own new_worktree moves
ROWS='[["state_icon", "workspace"], ["branch", "git_status", "$hg_bookmark", "$hg_status"]]'

# --- helpers -----------------------------------------------------------------

strip_managed() { # file -> stdout without our block or tagged lines
  awk -v b="$BEGIN" -v e="$END" -v t="$TAG" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    skip { next }
    index($0, t) && $0 ~ /# herdr-hg$/ { next }
    /^[[:space:]]*$/ { blanks = blanks $0 "\n"; next }   # hold blanks; drop trailing ones
    { printf "%s", blanks; blanks = ""; print }' "$1"
}

has_table() { grep -Eq "^[[:space:]]*\[$1\][[:space:]]*(#.*)?$" "$2"; }

# Insert $3 right after the [$1] header in file $2 (in place).
insert_after_table() {
  local tmp; tmp="$(mktemp)"
  awk -v hdr="$1" -v line="$3" '
    { print }
    !done { h = $0; sub(/[[:space:]]*#.*/, "", h); gsub(/[[:space:]]/, "", h)
            if (h == "[" hdr "]") { print line; done = 1 } }' "$2" >"$tmp" && cat "$tmp" >"$2" && rm -f "$tmp"
}

# Does table [$1] in file $2 already set key $3?
table_sets() {
  awk -v hdr="$1" -v key="$3" '
    { h = $0; sub(/[[:space:]]*#.*/, "", h); gsub(/[[:space:]]/, "", h) }
    h ~ /^\[/ { in_t = (h == "[" hdr "]"); next }
    in_t && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" { found = 1 }
    END { exit !found }' "$2"
}

is_setup() { # also false when the hgrc/shell blocks are from an older version
  [ -f "$HERDR_CONFIG" ] && grep -qF "$BEGIN" "$HERDR_CONFIG" &&
    [ -f "$HGRC" ] && grep -qF "$BEGIN" "$HGRC" && [ -x "$HOOK" ] &&
    current plan_hgrc "$HGRC" && { [ -z "$SHELLRC" ] || current plan_shellrc "$SHELLRC"; }
}
current() { # planner file: does file already match the plan?
  local t r; t="$(mktemp)"; "$1" "$t"; cmp -s "$t" "$2"; r=$?; rm -f "$t"; return $r
}

# --- herdr config.toml -------------------------------------------------------

plan_herdr_config() { # writes candidate config to $1, notes to stderr
  local out="$1" block
  mkdir -p "$(dirname "$HERDR_CONFIG")"; touch "$HERDR_CONFIG"
  strip_managed "$HERDR_CONFIG" >"$out"
  block="$BEGIN"$'\n'

  # Move herdr's git-only new_worktree off the key we take over.
  if has_table keys "$out"; then
    if table_sets keys "$out" new_worktree; then
      echo "  note: [keys].new_worktree is already customised; leaving it alone" >&2
    else
      insert_after_table keys "$out" "new_worktree = \"$KEY_GIT_NATIVE\"  $TAG"
    fi
  else
    block+=$'[keys]\n'"new_worktree = \"$KEY_GIT_NATIVE\""$'\n\n'
  fi

  local id key desc
  for spec in "new|$KEY_NEW|new worktree (hg/git)" \
              "open|$KEY_OPEN|open worktree (hg/git)" \
              "remove|$KEY_REMOVE|remove worktree (hg/git)" \
              "close-group|$KEY_CLOSE_GROUP|close hg repo + shares" \
              "info|$KEY_INFO|hg details"; do
    IFS='|' read -r id key desc <<<"$spec"
    block+="[[keys.command]]"$'\n'"key = \"$key\""$'\n'"type = \"plugin_action\""$'\n'
    block+="command = \"$PLUGIN_ID.$id\""$'\n'"description = \"$desc\""$'\n\n'
  done

  # Sidebar rows: only touch them if the user hasn't customised them.
  if table_sets ui.sidebar.spaces "$out" rows || table_sets ui.sidebar "$out" 'spaces\.rows' ||
     table_sets ui "$out" 'sidebar\.spaces\.rows' ||
     grep -Eq '^[[:space:]]*ui\.sidebar\.spaces\.rows[[:space:]]*=' "$out"; then
    echo "  note: Space sidebar rows are customised; add \"\$hg_bookmark\", \"\$hg_status\" to them yourself" >&2
  elif has_table ui.sidebar.spaces "$out"; then
    insert_after_table ui.sidebar.spaces "$out" "rows = $ROWS  $TAG"
  else
    block+=$'[ui.sidebar.spaces]\n'"rows = $ROWS"$'\n'
  fi

  block+="$END"
  { [ -s "$out" ] && echo; printf '%s\n' "$block"; } >>"$out"
}

apply_herdr_config() {
  local cand="$1"
  cp "$HERDR_CONFIG" "$HERDR_CONFIG.herdr-hg.bak"
  cat "$cand" >"$HERDR_CONFIG"
  if ! herdr config check >/dev/null 2>&1; then
    echo "  herdr rejected the new config, restoring backup:" >&2
    herdr config check >&2 || true
    cp "$HERDR_CONFIG.herdr-hg.bak" "$HERDR_CONFIG"
    echo "  Pick other keys in $CONFIG_DIR/config.env (HGWT_KEY_NEW, HGWT_KEY_OPEN," >&2
    echo "  HGWT_KEY_REMOVE, HGWT_KEY_CLOSE_GROUP, HGWT_KEY_INFO, HGWT_KEY_GIT_NATIVE) and run setup again." >&2
    return 1
  fi
  herdr server reload-config >/dev/null 2>&1 || echo "  (herdr not running; config applies on next start)"
}

# --- ~/.hgrc + hook shim -----------------------------------------------------

write_hook() {
  mkdir -p "$CONFIG_DIR"
  cat >"$HOOK" <<EOF
#!/bin/sh
# Installed by hgwt-setup. Called from ~/.hgrc hooks; resolves the plugin's
# current install dir each time so 'herdr plugin update' never breaks it.
[ -n "\$HERDR_ENV\$HERDR_WORKSPACE_ID" ] || exit 0
H="\${HERDR_BIN_PATH:-herdr}"
root=\$("\$H" plugin list --json --plugin $PLUGIN_ID 2>/dev/null | jq -r '.result.plugins[0].plugin_root // empty')
[ -n "\$root" ] && [ -x "\$root/bin/hgwt" ] || exit 0
case "\$1" in
  --*) HERDR_PLUGIN_CONFIG_DIR="$CONFIG_DIR" exec "\$root/bin/hgwt" refresh "\$@" ;;   # --pane ID DIR
  *) HERDR_PLUGIN_CONFIG_DIR="$CONFIG_DIR" exec "\$root/bin/hgwt" refresh --cwd "\$1" ;;
esac
EOF
  chmod +x "$HOOK"
}

on_path() { case ":$PATH:" in *":$BIN_DIR:"*) return 0 ;; *) return 1 ;; esac; }
shim_ours() { [ ! -e "$SHIM" ] || grep -qF "$SHIM_MARK" "$SHIM" 2>/dev/null; }
shim_needed() { on_path && shim_ours && [ ! -x "$SHIM" ]; }
write_shim() {
  on_path || { echo "  note: $BIN_DIR is not on PATH; skipping the hgwt command"; return 0; }
  shim_ours || { echo "  note: $SHIM exists and isn't ours; leaving it alone"; return 0; }
  mkdir -p "$BIN_DIR"
  cat >"$SHIM" <<SHIMEOF
#!/bin/sh
$SHIM_MARK
# Resolves the plugin's current install dir so 'herdr plugin update' never breaks it.
root=\$(herdr plugin list --json --plugin $PLUGIN_ID 2>/dev/null | jq -r '.result.plugins[0].plugin_root // empty')
[ -n "\$root" ] || { echo "hgwt: plugin $PLUGIN_ID is not installed in herdr" >&2; exit 1; }
exec "\$root/bin/hgwt" "\$@"
SHIMEOF
  chmod +x "$SHIM"
}

plan_hgrc() { # writes candidate hgrc to $1
  local cmd="sh -c '(\"$HOOK\" \"\$PWD\" >/dev/null 2>&1 &); true'"
  touch "$HGRC"
  strip_managed "$HGRC" >"$1"
  { [ -s "$1" ] && echo
    printf '%s\n[hooks]\nupdate.herdr = %s\ntxnclose.herdr = %s\npost-resolve.herdr = %s\n%s\n' \
      "$BEGIN" "$cmd" "$cmd" "$cmd" "$END"
  } >>"$1"
}

plan_shellrc() { # writes candidate shell rc to $1 (the hook only acts inside herdr panes)
  touch "$SHELLRC"
  strip_managed "$SHELLRC" >"$1"
  { [ -s "$1" ] && echo
    echo "$BEGIN"
    if [ "$SHELL_KIND" = zsh ]; then
      cat <<EOF
if [ -n "\${HERDR_PANE_ID:-}" ]; then
  _herdr_hg_chpwd() { ("$HOOK" --pane "\$HERDR_PANE_ID" "\$PWD" >/dev/null 2>&1 &) }
  autoload -Uz add-zsh-hook && add-zsh-hook chpwd _herdr_hg_chpwd
fi
EOF
    else
      cat <<EOF
if [ -n "\${HERDR_PANE_ID:-}" ]; then
  _herdr_hg_pwd="\$PWD"
  _herdr_hg_prompt() {
    [ "\$PWD" = "\$_herdr_hg_pwd" ] && return
    _herdr_hg_pwd="\$PWD"; ("$HOOK" --pane "\$HERDR_PANE_ID" "\$PWD" >/dev/null 2>&1 &)
  }
  PROMPT_COMMAND="_herdr_hg_prompt\${PROMPT_COMMAND:+;\$PROMPT_COMMAND}"
fi
EOF
    fi
    echo "$END"
  } >>"$1"
}

# --- main --------------------------------------------------------------------

show_diff() { diff -u --label "$1 (current)" --label "$1 (new)" "$1" "$2" | sed 's/^/  /' || true; }

case "${1:-}" in
  --status) is_setup; exit ;;
  --dismiss) mkdir -p "$CONFIG_DIR"; touch "$CONFIG_DIR/.setup-dismissed"; echo "Reminder dismissed."; exit 0 ;;
  --uninstall)
    for f in "$HERDR_CONFIG" "$HGRC" $SHELLRC; do
      [ -f "$f" ] || continue
      cp "$f" "$f.herdr-hg.bak"; tmp="$(mktemp)"; strip_managed "$f" >"$tmp"; cat "$tmp" >"$f"; rm -f "$tmp"
      echo "cleaned $f (backup: $f.herdr-hg.bak)"
    done
    rm -f "$HOOK"
    if [ -f "$SHIM" ] && grep -qF "$SHIM_MARK" "$SHIM"; then rm -f "$SHIM"; echo "removed $SHIM"; fi
    herdr server reload-config >/dev/null 2>&1 || true
    exit 0 ;;
  --yes|"") ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

command -v jq >/dev/null || { echo "hgwt-setup: jq is required" >&2; exit 1; }
command -v hg >/dev/null || echo "warning: hg not on PATH" >&2

cand_cfg="$(mktemp)"; cand_hgrc="$(mktemp)"; cand_rc="$(mktemp)"
trap 'rm -f "$cand_cfg" "$cand_hgrc" "$cand_rc"' EXIT
echo "herdr-hg setup"
echo
plan_herdr_config "$cand_cfg"
plan_hgrc "$cand_hgrc"
if [ -n "$SHELLRC" ]; then plan_shellrc "$cand_rc"; else rm -f "$cand_rc"; cand_rc=""; fi
if cmp -s "$cand_cfg" "$HERDR_CONFIG" && cmp -s "$cand_hgrc" "$HGRC" && [ -x "$HOOK" ] && ! shim_needed &&
   { [ -z "$cand_rc" ] || cmp -s "$cand_rc" "$SHELLRC"; }; then
  echo "Already set up, nothing to change."; exit 0
fi
echo "Changes to $HERDR_CONFIG:"; show_diff "$HERDR_CONFIG" "$cand_cfg"; echo
echo "Changes to $HGRC:"; show_diff "$HGRC" "$cand_hgrc"; echo
if [ -n "$cand_rc" ]; then
  echo "Changes to $SHELLRC (refreshes the sidebar after cd):"; show_diff "$SHELLRC" "$cand_rc"; echo
else
  echo "  note: no cd hook for shell '${SHELL:-?}' (zsh and bash only); the sidebar updates on focus instead"; echo
fi
echo "Hook helper: $HOOK"
echo "Command:     $SHIM (hgwt list/create/open/remove/prune/close-group/info)"; echo

if [ "${1:-}" != --yes ]; then
  printf 'Apply? [y/N] '; read -r ans; [ "$ans" = y ] || { echo "Nothing changed."; exit 0; }
fi

apply_herdr_config "$cand_cfg" || exit 1
write_hook
write_shim
cp "$HGRC" "$HGRC.herdr-hg.bak"; cat "$cand_hgrc" >"$HGRC"
if [ -n "$cand_rc" ] && ! cmp -s "$cand_rc" "$SHELLRC"; then
  cp "$SHELLRC" "$SHELLRC.herdr-hg.bak"; cat "$cand_rc" >"$SHELLRC"
  echo "Open a new shell (or: source $SHELLRC) for the cd hook."
fi
rm -f "$CONFIG_DIR/.setup-dismissed"
"$(dirname "$0")/hgwt" refresh --all >/dev/null 2>&1 || true
echo "Done. Backups: $HERDR_CONFIG.herdr-hg.bak, $HGRC.herdr-hg.bak${cand_rc:+, $SHELLRC.herdr-hg.bak}"
echo "Keys: $KEY_NEW new · $KEY_OPEN open · $KEY_REMOVE remove · $KEY_CLOSE_GROUP close repo+shares · $KEY_INFO details"
echo "      herdr's own git worktree key moved to $KEY_GIT_NATIVE"
